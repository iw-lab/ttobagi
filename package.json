{
  "name": "ttobagi",
  "version": "1.0.0",
  "private": true,
  "description": "또박이 — 초등 받아쓰기 앱 (서버 없는 정적 PWA, 운영비 0)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "APP_BASE=/ vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "qa": "APP_BASE=/ vite build && node scripts/visual-qa.mjs",
    "deploy": "APP_BASE=/ vite build && wrangler pages deploy dist --project-name ttobagi --branch main --commit-dirty=true",
    "qa:sound": "APP_BASE=/ vite build && node scripts/audio-check.mjs",
    "audio": "node scripts/build-audio.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "puppeteer": "^25.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  }
}
